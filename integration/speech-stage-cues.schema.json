{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "语音视觉与接话触发绑定 v1",
  "description": "scene 为跨组、preset 为同组；两者均整体应用序号对应的完整场景与人物配置，reply 独立去重。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocolVersion": {
      "const": 1
    },
    "scriptRevision": {
      "type": "integer",
      "minimum": 0
    },
    "manifestRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "cues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "sentence": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "blockIndex": {
                "type": "integer",
                "minimum": 0
              },
              "sentenceId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              }
            },
            "required": [
              "blockIndex",
              "sentenceId"
            ]
          },
          "sourceText": {
            "type": "string",
            "minLength": 1
          },
          "trigger": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "at": {
                    "const": "keyword"
                  },
                  "phrase": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 150
                  }
                },
                "required": [
                  "at",
                  "phrase"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "at": {
                    "const": "sentence-end"
                  }
                },
                "required": [
                  "at"
                ]
              }
            ]
          },
          "actions": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "scene": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "sceneId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  },
                  "presetId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  }
                },
                "required": [
                  "sceneId",
                  "presetId"
                ]
              },
              "preset": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "presetId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  }
                },
                "required": [
                  "presetId"
                ]
              },
              "reply": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "groupId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  }
                },
                "required": [
                  "groupId"
                ]
              }
            },
            "required": [],
            "minProperties": 1,
            "not": {
              "required": [
                "scene",
                "preset"
              ]
            }
          }
        },
        "required": [
          "id",
          "sentence",
          "sourceText",
          "trigger",
          "actions"
        ]
      }
    }
  },
  "required": [
    "protocolVersion",
    "scriptRevision",
    "manifestRevision",
    "cues"
  ]
}
